# Staging deploy target. Sourced by deploy/deploy-staging.sh.
#
# Nothing secret belongs in here — it is committed. Staging's application.yaml, which does hold
# secrets, lives only at $REMOTE_ROOT/conf/application.yaml on the host.

# SSH target for the staging VM. Still a placeholder: the three old dev instances
# (easy-dev / easy-dev-app / easy-dev-idp) are being triaged, and whichever becomes staging gets
# reimaged first — see doc/staging-environment.md §1. The script refuses to run until this is real.
SSH_TARGET="TODO@TODO"

# Layout on the host:
#   $REMOTE_ROOT/conf/application.yaml   core's config, out of repo, never overwritten by a deploy
#   $REMOTE_ROOT/releases/<sha>/         core.jar + web/, one directory per deployed commit
#   $REMOTE_ROOT/core/current.jar        symlink the easy-core systemd unit runs
#   $REMOTE_ROOT/web/current             symlink Apache's DocumentRoot points at
#   $REMOTE_ROOT/current-sha             what is live right now
REMOTE_ROOT="/srv/easy"

CORE_SERVICE="easy-core"

# Which branch `deploy-staging.sh latest` picks its newest green run from. A specific sha can come
# from any branch CI publishes artifacts for, release branches included.
DEPLOY_BRANCH="master"

WEB_URL="https://dev.lahendus.ut.ee"

# Any path under /v2 works — the script waits for a 401, which is what core returns for an
# unauthenticated request once its filter chain is up. See the comment at the poll.
HEALTH_URL="https://dev.ems.lahendus.ut.ee/v2/"

# Releases kept on disk. Each is a jar plus an unpacked dist, so roughly 60 MB apiece.
KEEP_RELEASES=5
