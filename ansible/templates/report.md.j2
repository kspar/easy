{# Renders one Markdown table for the whole environment: rows are facts, columns are inventory
   aliases. Columns are keyed by which of core/idp/executor a host belongs to, joined with `+` where
   one host wears several hats — dev co-locates all three, production separates them, and the point
   of the alias rule is that the two environments still line up beside each other.

   Nothing here prints a hostname, an address or a certificate subject. That is what lets the output
   be committed as a baseline and diffed. #}
{% set real_hosts = groups['all'] | default([]) | reject('equalto', 'localhost') | list %}
{% set cols = [] %}
{% for h in real_hosts %}
{%-   set aliases = [] %}
{%-   for g in ['core', 'idp', 'executor'] %}
{%-     if g in groups and h in groups[g] %}{{ aliases.append(g) or '' }}{% endif %}
{%-   endfor %}
{{-   cols.append({'label': aliases | join('+') if aliases else 'ungrouped', 'host': h}) or '' }}
{%- endfor %}
{% set rows = [
     ('OS', 'os'),
     ('Kernel', 'kernel'),
     ('CPU / RAM', 'cpu_ram'),
     ('Uptime', 'uptime'),
     ('Reboot', 'reboot'),
     ('Disk (size/avail/used)', 'disk'),
     ('Java (default)', 'java'),
     ('Java (per service)', 'service_java'),
     ('Keycloak', 'keycloak'),
     ('PostgreSQL clusters', 'postgres'),
     ('Units', 'units'),
     ('Deployed version', 'versions'),
     ('Firewall', 'ufw'),
     ('Public listeners', 'listening'),
     ('Cert days left', 'certs_days'),
     ('Backup last run', 'backup_last'),
     ('Config keys set', 'config_keys'),
   ] %}
