# Managed by Ansible (roles/core_service) — local edits are overwritten.

[Unit]
Description=Archive uploaded files nightly

[Timer]
OnCalendar={{ easy_files_backup_on_calendar }}
# No RandomizedDelaySec, unlike the database dump's. This has to finish before that one starts — see
# the ordering note in the role defaults — and jitter in front of a job whose own start already
# varies by twenty minutes would make the gap a matter of luck.
#
# Catches up, for the same reason the database dump does: this produces an artefact for a night that
# has no other copy, so a host that was down at the scheduled time should still take that archive
# when it comes back. A catch-up run breaks the ordering with the dump, and that is the right trade:
# a late archive paired with a dump from the same night beats no archive at all.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
