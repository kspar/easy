# Managed by Ansible (roles/core_rollout) — local edits are overwritten.

[Unit]
Description=Guarded rollout of the newest green build of {{ core_rollout_branch }}
Documentation=https://github.com/{{ core_rollout_repo }}/blob/master/doc/production-rollout.md
After=network-online.target postgresql.service
Wants=network-online.target
# The machinery failing — not a release failing, which the program reports itself — is reported by
# a separate unit, because a program that has crashed cannot send its own alert.
OnFailure=easy-rollout-alert.service

[Service]
Type=oneshot
User={{ core_rollout_user }}
Group={{ core_rollout_user }}
SupplementaryGroups={{ core_rollout_deploy_group }}

ExecStart=/usr/local/bin/easy-rollout --config {{ core_rollout_config_file }} tick

# A failed rollout is loud, has already rolled back or paused itself, and should be left alone.
Restart=no
# The backstop, not the mechanism: the program reads this budget, keeps its own clock and rolls
# back on its own before the budget runs out. If systemd ever does have to intervene, the SIGTERM it
# sends is handled the same way — rollback, pause, record — before the process exits.
TimeoutStartSec={{ core_rollout_unit_timeout_s }}
Environment=EASY_ROLLOUT_BUDGET_S={{ core_rollout_unit_timeout_s }}
# Stop the main process only: the rehearsal JVM is a transient unit of its own and the database
# helper's pg_restore must finish or fail on its own terms, not be killed half way through.
KillMode=mixed
TimeoutStopSec=900

# --- confinement --------------------------------------------------------------------------------
# It talks to GitHub and to this environment's public URLs, unpacks an archive, starts a JVM
# against a scratch database, and writes one tree.
NoNewPrivileges=no
# ^ NOT yes: this unit's work ends in `sudo systemctl restart`, and NoNewPrivileges makes sudo
#   fail with a message that never mentions it. What it can gain is listed in /etc/sudoers.d/easy-rollout.
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# The release tree, the state directory (under it) and the rehearsal's working directory.
ReadWritePaths={{ core_rollout_root }}
