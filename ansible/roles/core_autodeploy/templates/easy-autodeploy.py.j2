#!/usr/bin/env python3
"""Install the newest green CI build of {{ core_autodeploy_branch }} — managed by Ansible.

Pull, not push. This runs on the host and asks GitHub what exists; nothing in GitHub holds a
credential for this machine, and nothing outside can reach in. The cost is polling latency; the
benefit is that a compromised repository, workflow or Actions secret cannot become a shell here.

Idempotent by design: it compares the newest green run's commit against `current-sha` and exits
having done nothing when they match, which is what makes a {{ core_autodeploy_interval }} timer
cheap — one API call per tick in the steady state.

It writes the SAME on-host layout as deploy/deploy-staging.sh, which stays the way to deploy an
arbitrary commit (a rollback, or something off master). Those two implementations are separate on
purpose — one pushes from a laptop, one pulls on the host — but the layout below is a contract
between them, so change both together:

    {{ core_autodeploy_root }}/releases/<sha>/{core.jar,web/}
    {{ core_autodeploy_root }}/core/current.jar   -> releases/<sha>/core.jar
    {{ core_autodeploy_root }}/web/current        -> releases/<sha>/web
    {{ core_autodeploy_root }}/current-sha
"""
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.request
import zipfile
from pathlib import Path

REPO = "{{ core_autodeploy_repo }}"
BRANCH = "{{ core_autodeploy_branch }}"
WORKFLOW = "{{ core_autodeploy_workflow }}"
ROOT = Path("{{ core_autodeploy_root }}")
SERVICE = "{{ core_autodeploy_service }}"
KEEP = {{ core_autodeploy_keep_releases }}
TOKEN_FILE = Path("{{ core_autodeploy_token_file }}")
CONFIG_JSON = Path("{{ core_autodeploy_config_json }}")
HEALTH_URL = "{{ core_autodeploy_health_url }}"
API = "https://api.github.com"


def log(msg):
    # Plain stdout: systemd captures it into the journal with the unit's identifier, so there is
    # one place to look and nothing to rotate.
    print(msg, flush=True)


def die(msg):
    print(f"error: {msg}", file=sys.stderr, flush=True)
    sys.exit(1)


def token():
    if not TOKEN_FILE.exists():
        die(f"{TOKEN_FILE} does not exist")
    value = TOKEN_FILE.read_text().strip()
    if not value or value.startswith("CHANGEME"):
        # Not a crash: an unconfigured host should say so once a minute in the journal rather than
        # look like a broken deployer.
        log(f"{TOKEN_FILE} still holds a placeholder — nothing to do until a real token is in it")
        sys.exit(0)
    return value


class _StripAuthOnRedirect(urllib.request.HTTPRedirectHandler):
    """Drop the Authorization header when a request is redirected to another host.

    Artifact downloads need this. `archive_download_url` answers 302 to a **pre-signed** blob
    storage URL (productionresultssa*.blob.core.windows.net), and urllib carries the original
    headers across the redirect by default. Azure rejects a signed URL that also carries someone
    else's bearer token, with

        HTTP 401: Server failed to authenticate the request.
        Please refer to the information in the www-authenticate header.

    which mentions neither GitHub nor the token and reads exactly like the credential being wrong —
    a misdiagnosis worth one comment to prevent, since the natural next move is to go and reissue a
    token that was fine all along.
    """

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        new = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new is not None:
            new.remove_header("Authorization")
        return new


_OPENER = urllib.request.build_opener(_StripAuthOnRedirect)


def api(path, tok, raw=False):
    req = urllib.request.Request(
        path if path.startswith("http") else f"{API}{path}",
        headers={
            "Authorization": f"Bearer {tok}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "User-Agent": "easy-autodeploy",
        },
    )
    with _OPENER.open(req, timeout=300) as resp:
        return resp.read() if raw else json.load(resp)


def branch_head(tok):
    """The commit BRANCH currently points at."""
    return api(f"/repos/{REPO}/git/ref/heads/{BRANCH}", tok)["object"]["sha"]


def green_run_for(sha, tok):
    """The newest green run for `sha`, from ANY branch.

    Asking by commit rather than by branch is what stops a promotion costing a second full CI run.
    Pushing an already-built commit to this branch is a new push event, so Actions starts a fresh
    run of identical work on an identical tree — measured on 2026-08-09, every commit built twice,
    the two runs starting one second apart. The tree is what CI tested, and the tree is identified
    by the sha; which ref happened to point at it while the runner worked is not information about
    whether it passed.

    So `git push origin master:{{ core_autodeploy_branch }}` on a commit master already built green
    deploys on the next tick, without waiting for anything.

    `status=success` on the query is not the same question as `conclusion == "success"`, and
    artifacts are published per job — a run whose web job failed can still have left a jar behind.
    Gate on the run's own conclusion, exactly as deploy-staging.sh does.
    """
    runs = api(f"/repos/{REPO}/actions/runs?head_sha={sha}&status=success&per_page=20", tok)
    runs = [r for r in runs["workflow_runs"]
            if r["status"] == "completed"
            and r["conclusion"] == "success"
            and r["name"] == WORKFLOW]
    if not runs:
        return None
    # Sorted rather than trusting the API's order: a re-run should win over the original.
    return sorted(runs, key=lambda r: r["run_started_at"])[-1]


def artifact_urls(run_id, sha, tok):
    arts = api(f"/repos/{REPO}/actions/runs/{run_id}/artifacts", tok)["artifacts"]
    by_name = {a["name"]: a for a in arts}
    out = {}
    for want in (f"core-{sha}", f"web-{sha}"):
        art = by_name.get(want)
        if art is None:
            die(f"artifact {want} missing from run {run_id} "
                f"(have: {sorted(by_name)}) — artifacts expire after 90 days")
        if art.get("expired"):
            die(f"artifact {want} has expired")
        out[want] = art["archive_download_url"]
    return out


def fetch_release(run, sha, tmp, tok):
    """Download both artifacts and lay out core.jar + web.tar.gz in `tmp`."""
    urls = artifact_urls(run["id"], sha, tok)
    for name, url in urls.items():
        zip_path = tmp / f"{name}.zip"
        log(f"  downloading {name}")
        zip_path.write_bytes(api(url, tok, raw=True))
        with zipfile.ZipFile(zip_path) as z:
            z.extractall(tmp)
        zip_path.unlink()

    jar = next(iter(tmp.rglob(f"core-{sha}.jar")), None)
    tgz = next(iter(tmp.rglob(f"web-{sha}.tar.gz")), None)
    if jar is None:
        die(f"core-{sha}.jar not in the downloaded artifact")
    if tgz is None:
        die(f"web-{sha}.tar.gz not in the downloaded artifact")
    return jar, tgz


def materialise(run, sha, tok):
    """Make sure releases/<sha>/ holds core.jar and an unpacked web/. Returns that directory.

    Skipped entirely when the release is already there, which is the rollback path: moving back to
    a commit this host has run before should not depend on GitHub still holding its artifacts.
    """
    rel = ROOT / "releases" / sha
    if (rel / "core.jar").is_file() and (rel / "web" / "index.html").is_file():
        log("  already on disk, not re-downloading")
        return rel

    with tempfile.TemporaryDirectory() as td:
        tmp = Path(td)
        jar, tgz = fetch_release(run, sha, tmp, tok)
        rel.mkdir(parents=True, exist_ok=True)
        shutil.copy2(jar, rel / "core.jar")

        # Fresh directory each time, so a file deleted between releases does not linger.
        web = rel / "web"
        if web.exists():
            shutil.rmtree(web)
        web.mkdir()
        with tarfile.open(tgz) as t:
            # This process is not root, but say so anyway: the tarball is the one thing here that
            # comes from outside, and inheriting ownership or paths out of it is never wanted.
            t.extractall(web, filter="data")
    return rel


def activate(sha, rel):
    """Point the live symlinks at `rel`, after writing and checking this environment's config."""
    web = rel / "web"

    # Core reads this through --spring.config.location and dies on an unresolved @Value, so a
    # release adding a config key takes the environment down on restart. That is deliberate — this
    # is where it should be caught — but a missing file entirely is a setup mistake worth naming
    # before the service goes down for it.
    if not (ROOT / "conf" / "application.yaml").is_file():
        die(f"{ROOT}/conf/application.yaml does not exist — run the core_config role first")

    # CI strips config.json from the dist on purpose — web/public/config.json holds *production*
    # defaults, and an artifact carrying those is one forgotten step from staging talking to prod.
    # The environment's own copy is written here instead, on every deploy including rollbacks,
    # because this file belongs to the environment rather than to the release.
    if not CONFIG_JSON.is_file():
        die(f"{CONFIG_JSON} does not exist — it is this environment's config.json")
    shutil.copy2(CONFIG_JSON, web / "config.json")

    cfg = json.loads((web / "config.json").read_text())
    missing = [k for k in ("emsRoot",) if not cfg.get(k)]
    missing += ["keycloak." + k for k in ("url", "realm", "clientId")
                if not cfg.get("keycloak", {}).get(k)]
    if missing:
        die("config.json is missing: " + ", ".join(missing))
    if not (web / "index.html").is_file():
        die("no index.html in the unpacked dist")
    log(f"  config.json -> {cfg['emsRoot']}, realm {cfg['keycloak']['realm']} "
        f"at {cfg['keycloak']['url']}")

    # Flip both symlinks. `ln -sfn` over an existing symlink is not atomic — it unlinks first, and
    # a request landing in that window gets a 404 — so build beside and rename over.
    for link, target in ((ROOT / "web" / "current", web),
                         (ROOT / "core" / "current.jar", rel / "core.jar")):
        link.parent.mkdir(parents=True, exist_ok=True)
        tmp_link = link.with_name("." + link.name + ".new")
        if tmp_link.exists() or tmp_link.is_symlink():
            tmp_link.unlink()
        tmp_link.symlink_to(target)
        os.replace(tmp_link, link)


def restart():
    # Two exact commands are granted NOPASSWD to this account; anything else prompts and fails.
    subprocess.run(["sudo", "/usr/bin/systemctl", "restart", SERVICE], check=True)


def healthy():
    """Core answers 401 to an unauthenticated request once its filter chain is up."""
    import time
    for _ in range({{ core_autodeploy_health_attempts }}):
        time.sleep({{ core_autodeploy_health_interval }})
        try:
            urllib.request.urlopen(HEALTH_URL, timeout=10)
            return True
        except urllib.error.HTTPError as e:
            if e.code in (401, 403):
                return True
        except Exception:
            pass
    return False


def prune(keep_sha):
    rels = sorted((ROOT / "releases").glob("*/"), key=lambda p: p.stat().st_mtime, reverse=True)
    for i, d in enumerate(rels):
        if i < KEEP or d.name == keep_sha:
            continue
        log(f"  pruning {d.name}")
        shutil.rmtree(d, ignore_errors=True)


def main():
    tok = token()
    sha = branch_head(tok)

    current_file = ROOT / "current-sha"
    current = current_file.read_text().strip() if current_file.exists() else ""
    if sha == current:
        return  # Steady state. Silent on purpose: this runs every minute.

    # The branch has moved, so from here on something is expected to happen — which is why an
    # unbuilt commit says so rather than returning quietly like the case above. It repeats once a
    # minute until CI lands, and that is the intended volume: it is the answer to "I pushed, why is
    # nothing happening".
    run = green_run_for(sha, tok)
    if run is None:
        log(f"{BRANCH} is at {sha[:8]} but no green {WORKFLOW} run exists for it yet — waiting")
        return

    log(f"deploying {sha[:8]} (was {current[:8] or 'nothing'}) — {run['html_url']}")

    rel = materialise(run, sha, tok)
    activate(sha, rel)
    restart()

    if not healthy():
        die(f"core did not come up after deploying {sha[:8]} — "
            f"`journalctl -u {SERVICE} -n 40` on the host")

    from datetime import datetime, timezone
    (rel / "DEPLOYED").write_text(datetime.now(timezone.utc).isoformat() + "\n")
    current_file.write_text(sha + "\n")
    prune(sha)
    log(f"deployed {sha[:8]} and core is answering")


if __name__ == "__main__":
    main()
