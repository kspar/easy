# Managed by Ansible (roles/nginx) — local edits are overwritten.

{#
    A note about the security headers below, because they are written out four times and that is
    deliberate.

    **nginx does not inherit `add_header` the way this file reads as though it does.** Its rule is that
    `add_header` directives are inherited from the enclosing level *only if the current level defines
    none of its own* — so a location that sets its own `Cache-Control` silently drops every header set
    at server level. That is what had happened: `= /config.json`, `/assets/` and `/` each set a
    `Cache-Control`, so the three security headers reached none of them. They applied to the SPA
    document, the JS bundle and the runtime config not at all, and to proxied uploads — the one
    location that sets no `add_header` — perfectly. `always` does not help; it governs whether a header
    is sent on error responses, not inheritance.

    So any location that adds a header of its own repeats these. A Jinja macro would remove the
    repetition and is the wrong trade here: the rendered file on the host is what an operator reads
    when a header is missing, and it should say what is actually configured rather than expand to it.

    The API vhost sets its own two at server level and its locations add nothing, which is why they
    are correct without repetition — and why this was easy to miss, since the same file contains a
    working example of the thing that was broken.

    The content-security-policy is subject to the same rule and is now repeated the same way — five
    places, not four, because `/embed/` needed a location of its own to be exempt from
    `frame-ancestors`. Its *text* is a `set` variable rather than five copies: a ten-directive string
    duplicated five times is a divergence nobody would spot, whereas a one-line header per location
    still reads as "this location adds this header", which is the property worth keeping.
#}

# --- HTTP: ACME, and otherwise go away -----------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name {{ easy_nginx_web_host }} {{ easy_nginx_api_host }};

    # Renewal happens over HTTP-01, so this one path must stay reachable without TLS. It is served
    # from a webroot rather than by certbot's nginx plugin, which would rewrite this file.
    location ^~ /.well-known/acme-challenge/ {
        root {{ easy_nginx_acme_webroot }};
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

{% if easy_nginx_tls_ready %}
# --- the SPA -------------------------------------------------------------------------------------
server {
{% if easy_nginx_http2_directive | bool %}
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
{% else %}
    # `http2 on;` as its own directive is 1.25.1 and later. This nginx is older, where HTTP/2 is a
    # parameter on the listen line instead — and using the wrong one is a hard startup failure.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
{% endif %}
    server_name {{ easy_nginx_web_host }};

    ssl_certificate     {{ easy_nginx_cert_dir }}/fullchain.pem;
    ssl_certificate_key {{ easy_nginx_cert_dir }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling on;
    ssl_stapling_verify on;

    # --- Content-Security-Policy ------------------------------------------------------------------
    #
    # **Report-Only for now, deliberately.** Nothing is blocked; violations surface in the browser
    # console. Flipping to enforcement is renaming the header in the four `add_header` lines that
    # reference these variables — the policy itself is written once, here, because a ten-directive
    # string copied four times is a divergence nobody would see. The plain security headers above are
    # repeated rather than factored, for the reason at the top of this file, and a `set` keeps that
    # property — each location still states that it adds the header — without four copies of the text.
    #
    # Why this exists rather than as hardening for its own sake: an uploaded XHTML file executed script
    # on this origin, and rendered Markdown reaches fifteen `dangerouslySetInnerHTML` sites.
    # `script-src 'self'` is the directive that turns both from exploitable into blocked.
    #
    # Directive by directive, since each is a constraint someone would otherwise rediscover:
    #
    #   script-src 'self'        No inline script and no eval. `index.html` loads one module by src and
    #                            the Vite build emits no inline script, so no nonce is needed. This is
    #                            the line with the value in it; the rest is containment around it.
    #   style-src 'unsafe-inline' MUI/emotion injects styles at runtime, so this directive is weak by
    #                            necessity. Said plainly rather than left looking stronger than it is;
    #                            removing it needs a build that emits nonces.
    #   img-src https:           Stored exercise HTML references external images by absolute URL, in
    #                            quantity. Narrowing this blanks images across the library, and an
    #                            image is not a script vector.
    #   connect-src / frame-src  The API and the IdP are separate origins. `frame-src` is not optional:
    #                            keycloak-js runs check-sso in a hidden iframe, so omitting the IdP
    #                            breaks login outright rather than degrading it.
    #   frame-ancestors 'self'   Clickjacking against a logged-in teacher. Absent from the embed
    #                            policy below — that route exists to be framed on third-party course
    #                            pages, so a blanket deny would break the feature this protects.
    #
    # `easy_core_idp_base_url` is referenced with no default on purpose: it is an origin without a
    # path, both environments set it in `group_vars/all`, and a missing value should fail the run
    # rather than render a policy with a hole where the IdP should be.
    set $easy_csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://{{ easy_nginx_api_host }} {{ easy_core_idp_base_url }}; frame-src 'self' {{ easy_core_idp_base_url }}; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'";
    set $easy_csp_embeddable "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://{{ easy_nginx_api_host }} {{ easy_core_idp_base_url }}; frame-src 'self' {{ easy_core_idp_base_url }}; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'";

    # No includeSubDomains: this name has siblings (dev.ems, dev.idp, dev.aas) that are not all
    # guaranteed to be HTTPS-only, and a subdomain-wide pin is remembered by browsers long after the
    # header stops being sent.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy-Report-Only $easy_csp always;

    root {{ easy_nginx_web_root }};
    index index.html;

    # The environment's own settings, fetched at runtime rather than baked into the bundle
    # (EZ-1726). A cached copy would point a freshly deployed SPA at the previous environment's
    # backend, which fails in a way that looks like an application bug rather than a caching one.
    location = /config.json {
        add_header Cache-Control "no-store" always;
        # Repeated, not inherited — see the note at the top of this file.
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy-Report-Only $easy_csp always;
        try_files $uri =404;
    }

    # Vite emits content-hashed filenames, so these can be cached hard and for a long time.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        # Repeated, not inherited — see the note at the top of this file.
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy-Report-Only $easy_csp always;
        try_files $uri =404;
    }

    # Uploaded images, on the web origin. The URL stored inside an exercise or an article is
    # RELATIVE — /v2/resource/<key>/<filename> — so that the same content renders in every
    # environment; that is the whole reason core serves the file from its own domain rather than
    # writing a bucket URL into the HTML.
    #
    # Every environment needs this, not just dev: web and API are separate hostnames everywhere.
    # Without it an <img> falls through to the SPA location below and is answered with index.html —
    # a broken image whose response is a 200 full of HTML, which is a confusing thing to debug.
    #
    # Only /v2/resource/, not /v2/. The API belongs on its own origin, where CORS is configured;
    # proxying all of it here would quietly give the app a second, unconfigured way to reach core.
    location /v2/resource/ {
        proxy_pass http://{{ easy_nginx_api_upstream }};

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The embed route is built to be framed on somebody else's course page — `EmbedDialog` generates
    # the snippet a teacher pastes there — so it gets the policy *without* `frame-ancestors`. That is
    # the whole reason this location exists: `frame-ancestors 'self'` on the SPA is the clickjacking
    # control, and applying it here would break the one route whose job is to be embedded.
    #
    # Otherwise identical to `location /` below, because `/embed/...` is a SPA route like any other and
    # is answered with index.html. Kept as its own location rather than handled by a `map`, so that the
    # exemption is visible next to the thing it exempts.
    location /embed/ {
        add_header Cache-Control "no-cache" always;
        # Repeated, not inherited — see the note at the top of this file.
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy-Report-Only $easy_csp_embeddable always;
        try_files $uri $uri/ /index.html =404;
    }

    # A single-page app: every route that is not a real file is index.html, and index.html itself
    # must never be cached or a deploy does not reach anyone still holding the old one.
    location / {
        add_header Cache-Control "no-cache" always;
        # Repeated, not inherited — see the note at the top of this file.
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy-Report-Only $easy_csp always;
        # The trailing `=404` is not decoration. Without it, a request that falls through to
        # /index.html when that file does not exist — which is the state of this host until the first
        # deploy — re-enters this same location and nginx gives up with "rewrite or internal
        # redirection cycle", i.e. a 500 that looks like the proxy is broken rather than like there
        # is nothing deployed.
        try_files $uri $uri/ /index.html =404;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    access_log /var/log/nginx/{{ easy_nginx_web_host }}.access.log;
    error_log  /var/log/nginx/{{ easy_nginx_web_host }}.error.log;
}

# --- the API -------------------------------------------------------------------------------------
server {
{% if easy_nginx_http2_directive | bool %}
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
{% else %}
    # `http2 on;` as its own directive is 1.25.1 and later. This nginx is older, where HTTP/2 is a
    # parameter on the listen line instead — and using the wrong one is a hard startup failure.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
{% endif %}
    server_name {{ easy_nginx_api_host }};

    ssl_certificate     {{ easy_nginx_cert_dir }}/fullchain.pem;
    ssl_certificate_key {{ easy_nginx_cert_dir }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    client_max_body_size {{ easy_nginx_max_body_size }};

    # File uploads, and the only endpoint allowed to be large. The ceiling stays low everywhere else
    # deliberately: raising the global limit to accommodate one endpoint hands every other endpoint
    # the same allowance. Core enforces the real, per-role limits (20 MB teacher / 1 GB admin) after
    # the request arrives — this is what stops an oversized body reaching it at all.
    location = /v2/files {
        client_max_body_size {{ easy_nginx_upload_max_body_size }};

        proxy_pass http://{{ easy_nginx_api_upstream }};

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # A gigabyte over a slow connection takes longer than the default read timeout, and the
        # failure mode is a 504 partway through an upload that was going fine.
        proxy_read_timeout {{ easy_nginx_upload_timeout }};
        proxy_send_timeout {{ easy_nginx_upload_timeout }};
        proxy_request_buffering on;
    }

    location / {
        proxy_pass http://{{ easy_nginx_api_upstream }};

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_read_timeout {{ easy_nginx_proxy_read_timeout }};
        proxy_send_timeout {{ easy_nginx_proxy_read_timeout }};

        # CORS is core's job, not the proxy's: it is configurable per environment since EZ-1727, and
        # a header added here as well would arrive duplicated, which browsers reject outright.
    }

    access_log /var/log/nginx/{{ easy_nginx_api_host }}.access.log;
    error_log  /var/log/nginx/{{ easy_nginx_api_host }}.error.log;
}
{% else %}
# TLS blocks omitted: no certificate at {{ easy_nginx_cert_dir }} yet. The HTTP server above is what
# lets certbot obtain one over HTTP-01; re-running this role once it exists writes the rest.
{% endif %}
