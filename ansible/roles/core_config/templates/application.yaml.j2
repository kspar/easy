## Managed by Ansible (roles/core_config) — local edits are overwritten.
##
## Core reads this via --spring.config.location in easy-core.service.
##
## THIS FILE CONTAINS NO SECRETS, deliberately. The database password and the Keycloak client secret
## live in the file imported below, which Ansible never writes and never reads — it only checks that
## it exists, is owned correctly, and has the keys core needs. That way the only copy of a credential
## is the one on the server that has to exist anyway, rather than that copy plus another one on
## whichever laptop last ran the playbook.
##
## The two files hold disjoint keys, so their relative precedence never matters.
##
## If you are looking for the web bundle's config, that is config.json and the deploy script writes
## it; it holds no secrets either.

server:
  ## Loopback only. nginx terminates TLS and proxies to here.
  address: {{ easy_core_bind_address }}
  port: {{ easy_core_port }}

spring:
  config:
    ## Not `optional:` — core should refuse to start rather than come up with no database password
    ## and fail later in a way that looks like a database outage.
    import: "file:{{ easy_core_secrets_path }}"
  datasource:
    ## No `password:` here. It comes from the imported file above, which is the only place on this
    ## host a credential is written, and the only copy of it anywhere.
    jdbc-url: "jdbc:postgresql://{{ easy_core_db_host }}:{{ easy_core_db_port }}/{{ easy_core_db_name }}"
    username: "{{ easy_core_db_user }}"
    hikari:
      maximum-pool-size: {{ easy_core_db_pool_max }}
      minimum-idle: {{ easy_core_db_pool_min_idle }}
  mail:
    host: "{{ easy_core_mail_host }}"
    port: {{ easy_core_mail_port }}
    properties:
      mail:
        transport:
          protocol: "smtp"
        smtp:
          auth: {{ easy_core_mail_auth | bool | lower }}
          starttls:
            enable: {{ easy_core_mail_starttls | bool | lower }}
            required: {{ easy_core_mail_starttls | bool | lower }}
{% if easy_core_mail_auth | bool %}
    ## Omitted deliberately when SMTP needs no authentication, and when it does these belong in the
    ## imported secrets file rather than here — same rule as the database password. Spring treats
    ## both as optional, so their absence means "no auth" rather than "empty credentials".
{% endif %}
  servlet:
    multipart:
      ## The ceiling for POST /v2/files. Global, so it must be at least the larger of the two
      ## per-role limits below — the role check happens in the handler, after the request has been
      ## spooled to a temp file. nginx's client_max_body_size is what stops an oversized request
      ## reaching core at all, and the two are set together in roles/nginx.
      max-file-size: {{ easy_core_upload_max_bytes_admin }}
      max-request-size: {{ easy_core_upload_max_bytes_admin }}
  jackson:
    deserialization:
      FAIL_ON_NULL_FOR_PRIMITIVES: true
  security:
    oauth2:
      resourceserver:
        jwt:
          ## Both keys on purpose: jwk-set-uri keeps the key fetch lazy, so core starts even when the
          ## IdP is briefly unreachable, and issuer-uri adds issuer validation on top. issuer-uri
          ## alone makes startup fetch the IdP's metadata and couples core's boot to the IdP.
          jwk-set-uri: "{{ easy_core_idp_base_url }}{{ easy_core_idp_path_prefix }}/realms/{{ easy_core_keycloak_realm }}/protocol/openid-connect/certs"
          issuer-uri: "{{ easy_core_idp_base_url }}{{ easy_core_idp_path_prefix }}/realms/{{ easy_core_keycloak_realm }}"

easy:
  core:
    ## Must be true anywhere reachable: false installs DummyZeroAuthFilter, which trusts
    ## oidc_claim_* request headers verbatim. The role asserts this.
    auth-enabled: {{ easy_core_auth_enabled | bool | lower }}

    cors:
      ## Empty is the tighter setting, and correct when one proxy fronts both web and API on the same
      ## origin — the browser sends no preflight at all in that case.
      allowed-origins: "{{ easy_core_cors_allowed_origins }}"

    mail:
      from: "{{ easy_core_mail_from }}"
      sys:
        enabled: {{ easy_core_mail_sys_enabled | bool | lower }}
        to: "{{ easy_core_mail_sys_to }}"
      user:
        enabled: {{ easy_core_mail_user_enabled | bool | lower }}

    auto-assess:
      fixed-delay:
        ms: "{{ easy_core_autoassess_delay_ms }}"
      fixed-delay-observer-clear:
        ms: "{{ easy_core_autoassess_observer_clear_ms }}"
      anonymous-submissions-to-keep: "{{ easy_core_anonymous_submissions_to_keep }}"
    statistics:
      fixed-delay:
        ms: "{{ easy_core_statistics_delay_ms }}"

    moodle-sync:
      ## No `wstoken:` — imported from the secrets file. A dummy on an environment whose Moodle URL
      ## points at a discard port, a real credential on one whose does not, so it lives with the
      ## other credentials rather than in whichever category it happens to be in today.
      moodlewsrestformat: "{{ easy_core_moodle_format }}"
      users:
        url: "{{ easy_core_moodle_users_url }}"
        cron: "{{ easy_core_moodle_users_cron }}"
        wsfunction: "{{ easy_core_moodle_users_wsfunction }}"
      grades:
        ## Not only a manual endpoint and a cron — there is no grades cron at all, and
        ## syncSingleGradeToMoodle is called from ordinary grading (submissions.kt, TeacherPostGrade,
        ## TeacherRetryAutoassess). So on an environment with a real URL here, anyone submitting or
        ## grading anything writes to that gradebook. The allowlist below is the thing that bounds it.
        url: "{{ easy_core_moodle_grades_url }}"
        wsfunction: "{{ easy_core_moodle_grades_wsfunction }}"
      ## Comma-separated course shortnames, empty meaning unrestricted. Enforced immediately before
      ## the request is built, so it covers the grading paths above and not just the endpoints.
      course-allowlist: "{{ easy_core_moodle_course_allowlist }}"

    ## Where the bytes of uploaded files live. `local` is a directory on this host; `s3` is a bucket
    ## whose objects are publicly readable, which is the deployed answer (EZ-1571).
    ##
    ## No `access-key:` or `secret-key:` here — they are imported from the secrets file with the
    ## database password, and the role's credential grep would fail this file if they were not.
    ## Better still is an instance role, which needs neither.
    storage:
      backend: "{{ easy_core_storage_backend }}"
      local:
        dir: "{{ easy_core_storage_local_dir }}"
      s3:
        ## The bucket must serve objects publicly and must DENY anonymous ListBucket. The whole
        ## scheme rests on keys being unguessable, and a public listing hands them out — that is the
        ## easiest part of this to get wrong and the only part that cannot be fixed after the fact.
        bucket: "{{ easy_core_storage_s3_bucket }}"
        region: "{{ easy_core_storage_s3_region }}"
        endpoint: "{{ easy_core_storage_s3_endpoint }}"
        public-base-url: "{{ easy_core_storage_s3_public_base_url }}"

    upload:
      max-bytes:
        teacher: {{ easy_core_upload_max_bytes_teacher }}
        admin: {{ easy_core_upload_max_bytes_admin }}

    ## The only thing that deletes an uploaded file, and — with no reference columns on stored_file —
    ## the only thing that decides one is garbage. `delete: false` makes it report instead, which is
    ## where a new environment should stay until someone has read a night or two of that output.
    stored-file-sweep:
      cron: "{{ easy_core_stored_file_sweep_cron }}"
      grace-hours: {{ easy_core_stored_file_sweep_grace_hours }}
      delete: {{ easy_core_stored_file_sweep_delete | bool | lower }}

    exercise-index-normalisation:
      cron: "{{ easy_core_exercise_index_cron }}"

    activity:
      merge-window:
        s: "{{ easy_core_activity_merge_window_s }}"

    keycloak:
      ## This cron drives DeleteInactiveUsers, which deletes idle accounts from the database *and*
      ## from this Keycloak. On an environment holding imported data with historical last_seen
      ## values, an unpinned run deletes a large slice of it.
      cron: "{{ easy_core_keycloak_cron }}"
      ## The ORIGIN ONLY, with no path — deliberately different from the two URIs above, which have
      ## the /auth prefix on them.
      ##
      ## delete_inactive_users.kt builds "$keycloakBaseUrl/auth/realms/master/..." and
      ## "$keycloakBaseUrl/auth/admin/realms/$realm/..." — it appends `/auth` itself, in all three
      ## places. So a base-url that already ends in /auth produces /auth/auth/... and every admin call
      ## 404s. This was live and unnoticed until 2026-08-08, because dev pins the cron that drives
      ## it to a date that never comes, so the broken URL was never built.
      base-url: "{{ easy_core_idp_base_url }}"
      realm: "{{ easy_core_keycloak_realm }}"
      client-id: "{{ easy_core_keycloak_client_id }}"
      ## No `client-secret:` here either — imported, same reason as the database password.
      ignore-missing-keycloak-users: {{ easy_core_keycloak_ignore_missing_users | bool | lower }}

    ## Filing bug reports submitted in the app as YouTrack issues.
    ##
    ## Off loses nothing except the automatic issue: a report is stored in `bug_report` and mailed to
    ## the sys address regardless, so an environment with this disabled still hears about bugs.
    youtrack:
      enabled: {{ easy_core_youtrack_enabled | bool | lower }}
      base-url: "{{ easy_core_youtrack_base_url }}"
      ## YouTrack's OWN INTERNAL IDS, not `EZ` and not `EZ Team`. Its REST API does not accept the
      ## names people use, and resolving them at runtime would need admin-read scope the token has no
      ## reason to hold. doc/bug-reporting.md has the two curls that print them.
      project-id: "{{ easy_core_youtrack_project_id }}"
      ## Every issue filed by this integration is restricted to this group, unconditionally — there
      ## is no setting for "file it publicly", and doc/bug-reporting.md says why. Getting this id
      ## wrong does not make an issue public; it makes YouTrack reject the request, which is the
      ## failure direction to prefer.
      visibility-group-id: "{{ easy_core_youtrack_visibility_group_id }}"
      ## Catches outages and restarts. The first attempt happens as the report arrives, so this only
      ## ever picks up what that could not deliver.
      retry-cron: "{{ easy_core_youtrack_retry_cron }}"
      ## No `token:` here — imported from the secrets file, same reason as the database password. A
      ## key matching (password|secret|token) in this managed file fails the run further down.

  ## Public base URL of the web UI, used to build links in outgoing email — so a wrong value here
  ## sends real people to the wrong environment.
  web:
    base-url: "{{ easy_core_web_base_url }}"
