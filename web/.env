# Local-dev overrides only (copy to .env.local). Since EZ-1726 the real source of
# environment config is public/config.json, fetched at boot — see src/config.ts.
#
# These VITE_ vars are applied ONLY in `npm run dev`. A production build ignores them on
# purpose, so a built dist can never be pinned to one environment.
# VITE_EMS_ROOT=/v2
# VITE_KEYCLOAK_URL=https://idp.lahendus.ut.ee/auth/
# VITE_KEYCLOAK_REALM=master
# VITE_KEYCLOAK_CLIENT_ID=lahendus.ut.ee

# Dev-only, read by vite.config.ts rather than by the app — see devRoleOverride there.
#
# These two belong in `web/.env.local`, like everything else in this file: `devLocalSetting` opens
# `.env.local` and nothing else, so uncommenting them *here* silently does nothing (and dirties a
# tracked file).
#
# EASY_DEV_ROLE overrides the role in the oidc_claim_* headers the dev proxy sends, so API calls
# through the proxy run with that role. It changes what core sees, not what the SPA shows: the SPA
# takes its roles from the token, so with a plain-student IdP account the teacher-only pages still
# turn you away. For those, run against the Keycloak stub (docker-compose.override.yml.sample).
# Identity is untouched: you stay yourself, with different rights.
#
# EASY_DEV_AS supplies an identity when the bearer token carries none, which is the case under the
# Keycloak stub (docker-compose.override.yml.sample) whose token is a fixed string rather than a JWT.
# It implies a role of teacher,admin unless EASY_DEV_ROLE says otherwise.
# EASY_DEV_ROLE=teacher,admin
# EASY_DEV_AS=dev-teacher,teacher@test.ee
