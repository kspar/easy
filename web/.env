# Local-dev overrides only (copy to .env.local). Since EZ-1726 the real source of
# environment config is public/config.json, fetched at boot — see src/config.ts.
#
# These VITE_ vars are applied ONLY in `npm run dev`. A production build ignores them on
# purpose, so a built dist can never be pinned to one environment.
# VITE_EMS_ROOT=/v2
# VITE_KEYCLOAK_URL=https://idp.lahendus.ut.ee/auth/
# VITE_KEYCLOAK_REALM=master
# VITE_KEYCLOAK_CLIENT_ID=lahendus.ut.ee
