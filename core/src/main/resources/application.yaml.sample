
server:
  address: 127.0.0.1
  port: 8080

spring:
  datasource:
    jdbc-url: "<url>"
    username: "<username>"
    password: "<password>"
    hikari:
      maximum-pool-size: 90
      minimum-idle: 10
  mail:
    host: "<mailhost>"
    properties:
      mail:
        transport:
          protocol: "smtp"
        smtp:
          auth: true
          port: 587
          starttls:
            enable: true
            required: true
    username: "<username>"
    password: "<password>"
  servlet:
    multipart:
      # File uploads (POST /v2/files). This ceiling is global, so it has to be the larger of the two
      # per-role limits in easy.core.upload.max-bytes — the role check happens in the handler, by
      # which point the request has already been spooled to a temp file. nginx's
      # client_max_body_size is the bound that stops an oversized request reaching core at all.
      max-file-size: 1GB
      max-request-size: 1GB
  jackson:
    deserialization:
      FAIL_ON_NULL_FOR_PRIMITIVES: true
  security:
    oauth2:
      resourceserver:
        jwt:
          # Required whenever easy.core.auth-enabled is true: core verifies access tokens
          # itself against the realm's JWKS. Set both keys — jwk-set-uri makes the key fetch
          # lazy (core starts even if the IdP is briefly unreachable), and issuer-uri adds
          # issuer validation on top. Setting issuer-uri alone makes startup fetch the IdP's
          # metadata, coupling core's boot to the IdP being up.
          jwk-set-uri: "<idp-base-url>/realms/<realm>/protocol/openid-connect/certs"
          issuer-uri: "<idp-base-url>/realms/<realm>"


easy:
  core:
    # Never true on a deployed environment: false installs DummyZeroAuthFilter, which trusts
    # oidc_claim_* request headers verbatim. See doc/core/api-testing.md.
    auth-enabled: true

    db:
      # Apply changesets/testdata.xml — accounts, courses and exercises at fixed ids in the 9000s,
      # for local development. True here because this sample is what a local database is set up
      # from; defaults to FALSE in code, so an environment that does not name the key gets none.
      #
      # Never true on a deployed environment. Those fixtures insert at hardcoded ids, and a
      # deployed database has its own rows at them: on dev this failed the migration outright,
      # which for core means it does not start. See DatabaseConf.kt.
      test-data: true

    cors:
      # Origins allowed to call the API cross-origin — in practice the web app's origin, when it
      # is served from a different host than the API. Comma-separated, no spaces.
      #
      # Leave empty when one reverse proxy fronts both web and API on the same origin: browsers
      # send no preflight then, and an empty list is the tighter setting.
      #
      # Local dev needs nothing here either, because the Vite dev server proxies /v2 — unless you
      # point VITE_EMS_ROOT at an absolute URL, in which case add http://localhost:5173.
      allowed-origins: "https://lahendus.ut.ee"
    mail:
      from: "<from-address>"
      sys:
        enabled: true
        to: "<to-address>"
      user:
        enabled: true

    auto-assess:
        fixed-delay:
          ms: "3000"
        fixed-delay-observer-clear:
          ms: "3000"
        anonymous-submissions-to-keep: "50"
    statistics:
      fixed-delay:
        ms: "1000"

    moodle-sync:
      wstoken: "<token>"
      moodlewsrestformat: "json"
      users:
        url: "<url>"
        cron: "0 5 4 * * *"
        wsfunction: "local_ut_custom_get_course_groups_users"
      grades:
        url: "<url>"
        wsfunction: "local_ut_custom_update_manual_grades"
      # Moodle course shortnames this environment may contact, comma-separated. EMPTY MEANS
      # UNRESTRICTED, which is what production wants — it syncs whatever teachers have linked.
      #
      # Set it on any environment that must reach a real Moodle without being trusted with all of
      # it. Enforced immediately before the request is built, which matters because grades do not
      # reach Moodle through an endpoint at all: ordinary grading pushes them, so a check on the
      # sync endpoints would cover almost nothing.
      course-allowlist: ""

    # Where the bytes of uploaded files live. `local` writes them to a directory and needs no AWS
    # account, no credentials and no network — it is what a laptop and CI run on. `s3` is for
    # anything deployed. StorageServiceContractTest exercises both on every push.
    storage:
      backend: "local"    # local | s3
      local:
        dir: "/tmp/easy-files"
      s3:
        # The bucket's objects must be publicly readable and its listing must NOT be — the whole
        # scheme rests on keys being unguessable, and a public ListBucket hands them out.
        bucket: "<bucket>"
        region: "eu-north-1"
        # Empty for real AWS. Set it to run against MinIO or another S3-compatible server.
        endpoint: ""
        # What /v2/resource redirects to, e.g. https://<bucket>.s3.<region>.amazonaws.com
        public-base-url: "<public-base-url>"
        # Optional. Omit to use the SDK's default chain (environment, profile, instance role),
        # which is the better answer anywhere that can have one. Where it cannot, these go in the
        # imported secrets file — never in a config file that is in git.
        # access-key: "<access-key>"
        # secret-key: "<secret-key>"

    upload:
      # Per role, in bytes: 20 MB and 1 GB. spring.servlet.multipart.max-file-size has to be at
      # least the larger of the two, and nginx's client_max_body_size at least that again.
      max-bytes:
        teacher: 20971520
        admin: 1073741824

    # Collects uploaded files that no content references any more. Read the KDoc on StoredFileSweep
    # before changing any of this: with no reference columns left, this job is the only thing that
    # decides a file is garbage, and a missed content column means deleting a file that is in use.
    stored-file-sweep:
      cron: "0 0 4 * * *"
      # How long a file is left alone after upload, for the case of an editor that has not been
      # saved yet — that file is referenced by nothing anywhere and would otherwise be collected
      # out from under whoever is still typing.
      grace-hours: 24
      # False reports what it would delete and touches nothing. Turn it on deliberately, after
      # reading a night or two of that output, not as part of first deployment.
      delete: false

    exercise-index-normalisation:
      cron: "0 5 3 * * *"

    activity:
      merge-window:
        s: "300"

    keycloak:
      cron: "0 5 2 * * *"
      base-url: "<base-url>"
      realm: "<realm>"
      client-id: "<client-id>"
      client-secret: "<client-secret>"
      ignore-missing-keycloak-users: false

    # Filing bug reports submitted in the app as YouTrack issues. Off by default: a report is stored
    # in `bug_report` and emailed to the sys address whatever this says, so leaving it off loses
    # nothing except the automatic issue.
    #
    # `project-id` and `visibility-group-id` are YouTrack's own opaque ids, not `EZ` and not
    # `EZ Team` — the REST API does not accept the names. doc/bug-reporting.md has the two curls that
    # find them. The token lives in secrets.yaml, never here.
    #
    # Every issue this files is restricted to the group named by `visibility-group-id`, always. That
    # is not configurable, and doc/bug-reporting.md says why.
    youtrack:
      enabled: false
      base-url: "https://easy.youtrack.cloud"
      project-id: "<project-id>"
      visibility-group-id: "<group-id>"
      # The `Type` value stamped on a filed issue, as a bundle element id rather than its label.
      # Blank leaves the field alone and the project default applies — which is also the escape
      # hatch if this id is ever wrong, since blanking it restores filing without a code change.
      issue-type-id: "<type-bundle-element-id>"
      # Retries reports that could not be filed the first time. Hourly is plenty: the first attempt
      # happens immediately and this only catches outages and restarts.
      retry-cron: "0 20 * * * *"


  # Public base URL of the web UI, used to build links in outgoing emails.
  web:
    base-url: "https://easy.example"
