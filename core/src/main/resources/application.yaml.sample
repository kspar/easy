
server:
  address: 127.0.0.1
  port: 8080

spring:
  datasource:
    jdbc-url: "<url>"
    username: "<username>"
    password: "<password>"
    hikari:
      maximum-pool-size: 90
      minimum-idle: 10
  mail:
    host: "<mailhost>"
    properties:
      mail:
        transport:
          protocol: "smtp"
        smtp:
          auth: true
          port: 587
          starttls:
            enable: true
            required: true
    username: "<username>"
    password: "<password>"
  jackson:
    deserialization:
      FAIL_ON_NULL_FOR_PRIMITIVES: true
  security:
    oauth2:
      resourceserver:
        jwt:
          # Required whenever easy.core.auth-enabled is true: core verifies access tokens
          # itself against the realm's JWKS. Set both keys — jwk-set-uri makes the key fetch
          # lazy (core starts even if the IdP is briefly unreachable), and issuer-uri adds
          # issuer validation on top. Setting issuer-uri alone makes startup fetch the IdP's
          # metadata, coupling core's boot to the IdP being up.
          jwk-set-uri: "<idp-base-url>/realms/<realm>/protocol/openid-connect/certs"
          issuer-uri: "<idp-base-url>/realms/<realm>"


easy:
  core:
    # Never true on a deployed environment: false installs DummyZeroAuthFilter, which trusts
    # oidc_claim_* request headers verbatim. See doc/core/api-testing.md.
    auth-enabled: true

    db:
      # Apply changesets/testdata.xml — accounts, courses and exercises at fixed ids in the 9000s,
      # for local development. True here because this sample is what a local database is set up
      # from; defaults to FALSE in code, so an environment that does not name the key gets none.
      #
      # Never true on a deployed environment. Those fixtures insert at hardcoded ids, and a
      # deployed database has its own rows at them: on dev this failed the migration outright,
      # which for core means it does not start. See DatabaseConf.kt.
      test-data: true

    cors:
      # Origins allowed to call the API cross-origin — in practice the web app's origin, when it
      # is served from a different host than the API. Comma-separated, no spaces.
      #
      # Leave empty when one reverse proxy fronts both web and API on the same origin: browsers
      # send no preflight then, and an empty list is the tighter setting.
      #
      # Local dev needs nothing here either, because the Vite dev server proxies /v2 — unless you
      # point VITE_EMS_ROOT at an absolute URL, in which case add http://localhost:5173.
      allowed-origins: "https://lahendus.ut.ee"
    mail:
      from: "<from-address>"
      sys:
        enabled: true
        to: "<to-address>"
      user:
        enabled: true

    auto-assess:
        fixed-delay:
          ms: "3000"
        fixed-delay-observer-clear:
          ms: "3000"
        anonymous-submissions-to-keep: "50"
    statistics:
      fixed-delay:
        ms: "1000"

    moodle-sync:
      wstoken: "<token>"
      moodlewsrestformat: "json"
      users:
        url: "<url>"
        cron: "0 5 4 * * *"
        wsfunction: "local_ut_custom_get_course_groups_users"
      grades:
        url: "<url>"
        wsfunction: "local_ut_custom_update_manual_grades"

    exercise-index-normalisation:
      cron: "0 5 3 * * *"

    activity:
      merge-window:
        s: "300"

    keycloak:
      cron: "0 5 2 * * *"
      base-url: "<base-url>"
      realm: "<realm>"
      client-id: "<client-id>"
      client-secret: "<client-secret>"
      ignore-missing-keycloak-users: false


  # Public base URL of the web UI, used to build links in outgoing emails.
  web:
    base-url: "https://easy.example"
