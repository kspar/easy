<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="220226-1" author="kspar">
        <!-- Add new jsonb feedback column and migrate existing data -->
        <addColumn tableName="teacher_activity">
            <column name="feedback" type="jsonb">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <sql><![CDATA[
            UPDATE teacher_activity
            SET feedback = jsonb_build_object(
                'general_md', feedback_adoc,
                'general_html', feedback_html,
                'inline', '[]'::jsonb
            )
            WHERE feedback_adoc IS NOT NULL;
        ]]></sql>
    </changeSet>

    <changeSet id="220226-2" author="kspar">
        <!-- Drop old columns after data has been migrated -->
        <dropColumn tableName="teacher_activity" columnName="feedback_adoc"/>
        <dropColumn tableName="teacher_activity" columnName="feedback_html"/>
    </changeSet>

    <changeSet id="220226-3" author="kspar">
        <renameColumn tableName="feedback_snippet"
                      oldColumnName="snippet_adoc" newColumnName="snippet_md"/>
    </changeSet>

    <changeSet id="260225-1" author="kspar">
        <!-- Revert JSONB feedback column back to separate text columns (JSONB was never deployed to prod) -->
        <dropColumn tableName="teacher_activity" columnName="feedback"/>
        <addColumn tableName="teacher_activity">
            <column name="feedback_md" type="text"><constraints nullable="true"/></column>
            <column name="feedback_html" type="text"><constraints nullable="true"/></column>
        </addColumn>
    </changeSet>

    <changeSet id="260225-2" author="kspar">
        <!-- Standalone inline comments table — comments are independent of teacher_activity -->
        <createTable tableName="teacher_inline_comment">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="course_exercise_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_inline_comment_course_exercise" references="course_exercise(id)"/>
            </column>
            <column name="submission_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_inline_comment_submission" references="submission(id)"/>
            </column>
            <column name="teacher_id" type="text">
                <constraints nullable="false" foreignKeyName="fk_inline_comment_teacher" references="account(username)"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="edited_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="line_start" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="line_end" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="text_md" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="text_html" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="suggested_code" type="text">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <createIndex tableName="teacher_inline_comment" indexName="idx_inline_comment_submission">
            <column name="submission_id"/>
        </createIndex>
        <createIndex tableName="teacher_inline_comment" indexName="idx_inline_comment_ce_teacher">
            <column name="course_exercise_id"/>
            <column name="teacher_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
