<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="220226-1" author="kspar">
        <!-- Add new jsonb feedback column and migrate existing data.

             The predicate takes either column, not just feedback_adoc: 220226-2 drops both, so a row
             holding rendered HTML and no source would have lost it silently. Whether production has
             such rows is unknown and does not need to be known — this costs nothing either way.
             validCheckSum because databases that ran the narrower version are already past it. -->
        <validCheckSum>ANY</validCheckSum>
        <addColumn tableName="teacher_activity">
            <column name="feedback" type="jsonb">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <sql><![CDATA[
            UPDATE teacher_activity
            SET feedback = jsonb_build_object(
                'general_md', feedback_adoc,
                'general_html', feedback_html,
                'inline', '[]'::jsonb
            )
            WHERE feedback_adoc IS NOT NULL OR feedback_html IS NOT NULL;
        ]]></sql>
    </changeSet>

    <changeSet id="220226-2" author="kspar">
        <!-- Drop old columns after data has been migrated -->
        <dropColumn tableName="teacher_activity" columnName="feedback_adoc"/>
        <dropColumn tableName="teacher_activity" columnName="feedback_html"/>
    </changeSet>

    <changeSet id="220226-3" author="kspar">
        <renameColumn tableName="feedback_snippet"
                      oldColumnName="snippet_adoc" newColumnName="snippet_md"/>
    </changeSet>

    <changeSet id="260225-1" author="kspar">
        <!--
            Revert the JSONB feedback column back to separate text columns.

            This used to drop `feedback` and add two empty columns, on the reasoning recorded in its
            old comment: "JSONB was never deployed to prod". That is true, and it is precisely why
            dropping was wrong. A database which had not run 220226-1 yet — production, and any
            restored copy of it — runs the whole sequence in order on the next deploy: 220226-1 copies
            feedback_adoc into `feedback`, 220226-2 drops feedback_adoc, and this changeset then
            dropped `feedback`. Every teacher feedback text in the database, gone, with the migration
            reporting success.

            Found on dev, 2026-08-10, by importing a production dump: teacher_activity arrived with
            thousands of feedback_adoc values and came out of the migration with none. The same
            deploy against production would have done the same thing to the same rows.

            So it carries the data across before dropping. On a database that already ran the old
            version the copy is a no-op over columns that are already empty, and validCheckSum keeps
            that database from failing validation on the changed body.
        -->
        <validCheckSum>ANY</validCheckSum>
        <addColumn tableName="teacher_activity">
            <column name="feedback_md" type="text"><constraints nullable="true"/></column>
            <column name="feedback_html" type="text"><constraints nullable="true"/></column>
        </addColumn>
        <sql><![CDATA[
            UPDATE teacher_activity
            SET feedback_md = feedback ->> 'general_md',
                feedback_html = feedback ->> 'general_html'
            WHERE feedback IS NOT NULL;
        ]]></sql>
        <dropColumn tableName="teacher_activity" columnName="feedback"/>
    </changeSet>

    <changeSet id="260225-2" author="kspar">
        <!-- Standalone inline comments table — comments are independent of teacher_activity -->
        <createTable tableName="teacher_inline_comment">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="course_exercise_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_inline_comment_course_exercise" references="course_exercise(id)"/>
            </column>
            <column name="submission_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_inline_comment_submission" references="submission(id)"/>
            </column>
            <column name="teacher_id" type="text">
                <constraints nullable="false" foreignKeyName="fk_inline_comment_teacher" references="account(username)"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="edited_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="line_start" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="line_end" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="text_md" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="text_html" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="suggested_code" type="text">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <createIndex tableName="teacher_inline_comment" indexName="idx_inline_comment_submission">
            <column name="submission_id"/>
        </createIndex>
        <createIndex tableName="teacher_inline_comment" indexName="idx_inline_comment_ce_teacher">
            <column name="course_exercise_id"/>
            <column name="teacher_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="310726-1" author="kspar">
        <comment>
            Markdown source columns for exercise text, course exercise instructions and article
            text, finishing the migration that already covers feedback (EZ-1729). The matching
            *_adoc columns are deliberately left in place: their content is the only copy of the
            source for anything authored before this, and the rendered *_html is what gets served.
            Dropping them needs a backfill decision first.
        </comment>
        <addColumn tableName="exercise_version">
            <column name="text_md" type="text">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <addColumn tableName="course_exercise">
            <column name="instructions_md" type="text">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <addColumn tableName="article_version">
            <column name="text_md" type="text">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="020826-1" author="kspar">
        <comment>
            Make anonymous_autoassess_template non-nullable, defaulting to the empty string.

            It was nullable with no default, and the PATCH that writes it treats an absent value as
            "leave unchanged" — so once a template was set there was no way to unset it, and "no
            template" had two representations depending on whether one had ever been saved. One
            empty-string spelling removes both problems: absent still means unchanged, and ""
            clears.
        </comment>
        <addNotNullConstraint tableName="exercise"
                              columnName="anonymous_autoassess_template"
                              columnDataType="text"
                              defaultNullValue=""/>
        <addDefaultValue tableName="exercise"
                         columnName="anonymous_autoassess_template"
                         columnDataType="text"
                         defaultValue=""/>
    </changeSet>

    <changeSet id="100826-1" author="kspar">
        <comment>
            Give management notifications a schedule, a severity, an optional link and an audience.

            The table already existed with a single `message` column and a full admin CRUD, but no
            web UI ever used it, and a message once created was shown to everyone forever until an
            admin deleted it by id. That is why nobody used it: announcing planned maintenance meant
            remembering to remove the notice afterwards.

            Roles are three booleans rather than a join table. There are exactly three of them and
            the set does not change; a join table would be tidier in the abstract and worse at every
            query that actually runs. All three default true, so every row that already exists keeps
            its current behaviour of being shown to everyone.

            visible_from / visible_until are both nullable, and null is not "unset" but "no bound" —
            null from means visible immediately, null until means visible until removed. That makes
            the existing rows correct rather than requiring a backfill.
        </comment>
        <addColumn tableName="management_notification">
            <column name="severity" type="text" defaultValue="INFO">
                <constraints nullable="false"/>
            </column>
            <column name="link_url" type="text">
                <constraints nullable="true"/>
            </column>
            <column name="link_label" type="text">
                <constraints nullable="true"/>
            </column>
            <column name="visible_from" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="visible_until" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="for_students" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="for_teachers" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="for_admins" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
