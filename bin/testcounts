#!/usr/bin/env bash
#
# Print the measured suite sizes, so nobody types them again.
#
#   bin/testcounts            # sizes only — fast, no test runs
#   bin/testcounts --run      # also run every suite and report what each one reports
#
# ## Why this exists
#
# `doc/testing.md` prints the shell command beside each figure precisely because hand-maintained
# numbers go stale, and they went stale anyway — **three times in two days**, each time because the
# repo moved between someone measuring and someone reading. Printing the command was not enough:
# it still asked a human to run six of them and add up a seventh.
#
# So this is the command. One invocation, every number, in the shape the document wants them.
#
# Not a CI gate, on purpose. Two of these figures are environment-dependent — `aae` reports a
# different count depending on whether `tiivad` is installed, and the browser suite skips a spec
# that needs a real core — so a hard equality check would fail for reasons that are not defects.
# The gates that *are* worth failing on live elsewhere: the check-count ratchet, Kover targets, and
# the three baseline files.
set -uo pipefail
cd "$(dirname "$0")/.."

RUN=false
[ "${1:-}" = "--run" ] && RUN=true

count() { printf '  %-46s %s\n' "$1" "$2"; }

echo "Sizes (measured at $(git rev-parse --short HEAD)$([ -n "$(git status --porcelain)" ] && echo ', working tree dirty'))"
echo
count "core @RestController classes" "$(grep -rl '@RestController' core/src/main/kotlin | wc -l | tr -d ' ')"
count "core test files" "$(find core/src/test/kotlin -name '*.kt' | wc -l | tr -d ' ')"
count "web .ts/.tsx sources" "$(find web/src -name '*.ts' -o -name '*.tsx' | wc -l | tr -d ' ')"
count "web unit files" "$(ls web/tests/unit/*.test.mjs 2>/dev/null | wc -l | tr -d ' ')"
count "web browser specs" "$(ls web/tests/browser/*.spec.mjs 2>/dev/null | wc -l | tr -d ' ')"
count "aae test files" "$(ls aae/tests/test_*.py 2>/dev/null | wc -l | tr -d ' ')"
count "bin/mutate.sh mutations" "$(grep -c '^mutate ' bin/mutate.sh)"

# The browser total is the sum of a file the runner writes, which is the only one of these that is
# already immune to being typed — `expected-checks.json` is regenerated by `npm run test:browser:record`.
python3 - <<'PY'
import json
try:
    d = json.load(open('web/tests/expected-checks.json'))
    s = {k: v for k, v in d.items() if not k.startswith('_')}
    print(f"  {'web browser checks (expected-checks.json)':<46} {sum(s.values())} across {len(s)} specs")
except Exception as e:
    print(f"  web browser checks: unavailable ({e})")
PY

# The contract artefact, for the same reason: doc/testing.md quoted "123 endpoints, 194 types, 184
# nullable fields" and two of the three had drifted to 196 and 188 before anyone noticed — the file
# is regenerated by a test, so only the prose describing it could go stale.
python3 - <<'PY'
import json
try:
    d = json.load(open('doc/core/api-shapes.json'))
    types = d['types']
    nullable = sum(1 for t in types.values() for p in t.values()
                   if isinstance(p, dict) and p.get('nullable'))
    enums = sum(1 for t in types.values() for p in t.values()
                if isinstance(p, dict) and p.get('kind') == 'enum')
    print(f"  {'api-shapes.json (endpoints / types)':<46} {len(d['endpoints'])} / {len(types)}")
    print(f"  {'api-shapes.json (nullable / enum fields)':<46} {nullable} / {enums}")
except Exception as e:
    print(f"  api-shapes.json: unavailable ({e})")
PY

$RUN || { echo; echo "Add --run to also run every suite. Nothing above ran a test."; exit 0; }

echo
echo "Reported by each runner"
echo

# `--rerun-tasks` is not optional. Without it Gradle reports the task UP-TO-DATE and prints no
# summary line at all, so this reported an empty count for tsl the first time it ran — the same
# staleness trap `bin/mutate.sh` documents, arriving here by a different door.
jvm() {
  JAVA_HOME="${JAVA_HOME:-$(/usr/libexec/java_home -v 25 2>/dev/null || true)}" \
    ./gradlew $1 --rerun-tasks 2>&1 | grep -oE 'Tests \([a-z-]+\): [0-9]+ completed[^)]*'
}
# strip pytest's colour, which is on because it is talking to a pipe it thinks is a terminal
plain() { sed -E 's/\x1b\[[0-9;]*m//g'; }

jvm ':core:test' | while read -r line; do count "core" "$line"; done
jvm ':tsl:test :tsl-common:test' | while read -r line; do count "jvm" "$line"; done

# The same interpreter for all three Python suites: CI runs bin/tests and the reconciler from the
# repo root in the `executor` job, which has aae's dev requirements installed. Locally that is the
# aae venv, and the system python3 has no pytest at all.
PY_BIN=aae/.venv/bin/python
if [ -x "$PY_BIN" ]; then
  tiivad=$("$PY_BIN" -c 'import tiivad' 2>/dev/null && echo 'tiivad installed' || echo 'no tiivad, so some skip')
  count "aae ($tiivad)" \
    "$( (cd aae && PYTHONDONTWRITEBYTECODE=1 .venv/bin/python -m pytest tests -q --no-header -p no:warnings 2>&1 | plain | tail -1) )"
  # aae has two legitimate totals, so report the split rather than leaving a reader to work out
  # whether a smaller number on their laptop means something is broken. Derived from which tests
  # carry @needs_tiivad, not from a figure anyone maintains — that figure was wrong twice.
  (cd aae && .venv/bin/python -m pytest tests --collect-only -q --no-header -p no:warnings 2>/dev/null) \
    | plain > "${TMPDIR:-/tmp}/easy-aae-collected.$$"
  "$PY_BIN" - "${TMPDIR:-/tmp}/easy-aae-collected.$$" <<'PYEOF'
import ast, sys
tree = ast.parse(open('aae/tests/test_tiivad_contract.py').read())
gated = [n.name for n in ast.walk(tree) if isinstance(n, ast.FunctionDef)
         and any(getattr(d, 'id', None) == 'needs_tiivad' for d in n.decorator_list)]
lines = open(sys.argv[1]).read().splitlines()
total = sum(1 for l in lines if '::' in l)
n = sum(1 for l in lines if any(g in l for g in gated))
print(f"  {'aae split':<46} {total} collected — {n} need tiivad, {total - n} without")
PYEOF
  rm -f "${TMPDIR:-/tmp}/easy-aae-collected.$$"
  [ -d bin/tests ] && count "bin (pins parser)" \
    "$(PYTHONDONTWRITEBYTECODE=1 "$PY_BIN" -m pytest bin/tests -q --no-header -p no:warnings 2>&1 | plain | tail -1)"
  [ -d ansible/roles/executor_images/tests ] && count "ansible (grading-image reconciler)" \
    "$(PYTHONDONTWRITEBYTECODE=1 "$PY_BIN" -m pytest ansible/roles/executor_images/tests -q --no-header -p no:warnings 2>&1 | plain | tail -1)"
  [ -d doc/core/adoc-to-md/tests ] && count "adoc->md (dry-run classifier)" \
    "$(PYTHONDONTWRITEBYTECODE=1 "$PY_BIN" -m pytest doc/core/adoc-to-md/tests -q --no-header -p no:warnings 2>&1 | plain | tail -1)"
else
  count "python suites" "skipped — no aae/.venv (see DEVELOPMENT.md)"
fi

count "web unit" "$( (cd web && npx vitest run 2>&1 | grep -oE 'Tests +[0-9]+ passed \([0-9]+\)' | tail -1) )"
echo
echo "The browser suite is not run here — it takes ~5 minutes and writes expected-checks.json"
echo "itself. Use: cd web && npm run test:browser:record"
