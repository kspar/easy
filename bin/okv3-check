#!/usr/bin/env python3
"""Check a grading library's output against the OK_V3 result format.

    some-grader < submission | bin/okv3-check
    bin/okv3-check result.json

Reads the whole input the way the executor does: it must be exactly one JSON document, so a grader
that prints a warning first fails here as it would fail there. Exit 0 when the document is valid
OK_V3, 1 with a line per problem when it is not, 2 when the input is not JSON at all or jsonschema
is not installed (`pip install jsonschema`).

The schema is doc/aae/ok-v3.schema.json; the prose is doc/aae/feedback-format.md.
"""
import json
import pathlib
import sys


def main(argv):
    if len(argv) > 2 or argv[1:] in (["-h"], ["--help"]):
        print(__doc__.strip(), file=sys.stderr)
        return 2

    try:
        import jsonschema
    except ImportError:
        print("jsonschema is not installed: pip install jsonschema", file=sys.stderr)
        return 2

    schema_file = pathlib.Path(__file__).resolve().parent.parent / "doc" / "aae" / "ok-v3.schema.json"
    schema = json.loads(schema_file.read_text(encoding="utf-8"))

    raw = pathlib.Path(argv[1]).read_text(encoding="utf-8") if len(argv) == 2 else sys.stdin.read()
    try:
        document = json.loads(raw)
    except json.JSONDecodeError as e:
        print(f"not a single JSON document ({e}); the executor would fall back to the legacy "
              f"format and then to 'unexpected error'. Is something else printing to stdout or "
              f"stderr?", file=sys.stderr)
        return 2

    problems = sorted(jsonschema.Draft202012Validator(schema).iter_errors(document),
                      key=lambda e: list(e.absolute_path))
    for e in problems:
        where = "/".join(str(p) for p in e.absolute_path) or "<root>"
        print(f"{where}: {e.message}")
    if problems:
        return 1
    print("valid OK_V3", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
